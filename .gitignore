.env
markets.json
users.json

node_modules/
/back-end/flask_session
/back-end/data/
/back-end/__pycache__
/back-end/docker-compose.yml
/back-end/error.log
/back-end/logs
# Generated dev artifacts live here, but the Google Forms exports, the invented example_columns.csv
# and their README are fixtures the suite asserts against - tests/test_form_export_shapes.py,
# tests/test_google_forms_corpus.py and tests/test_csv_start.py cannot run without them.
/back-end/tests/test_data/*
!/back-end/tests/test_data/google_forms/
!/back-end/tests/test_data/README.md
!/back-end/tests/test_data/example_columns.csv
# Playwright writes into front-end/, which front-end/.gitignore covers. These two guard the
# repo root, where a stale .last-run.json was tracked from PR #33 and shipped in v0.1.0.
/test-results
/playwright-report
.DS_Store
/.cursor

.omo/

*__pycache__*

# Logs
*.log
tmux-*.log
flask_session/
/.stack-logs

# Lavish review artifacts. The published report is committed because the backlog cites it as the
# evidence for E07/E08/E01-F04; its fonts are copies of front-end/public/fonts and the MCP session
# dumps are throwaway.
/.playwright-mcp
/.lavish/*.ttf

# Verification screenshots taken through the Playwright MCP browser, which resolves relative paths
# against the repo root rather than front-end/ (where an identical rule already lives).
/e2e-screenshots

# A transient, task-local working folder (spec, tickets, notes); planning lives outside this repo.
# In the primary checkout, .scratch/examples/ holds real applicants' data. Never commit any of it.
.scratch/

# Obsidian's workspace state, for anyone who opens the repository as a vault (docs/README.md).
.obsidian/

# A developer's own Compose override, such as publishing a port beyond 127.0.0.1 (docs/STARTUP.md).
docker-compose.override.yml
