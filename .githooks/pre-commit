#!/bin/sh
# Refuses a commit whose staged lines hold a real person's email, phone or name
# (scripts/real_data_check.py), then runs any pre-commit hook installed in the git directory,
# which core.hooksPath would otherwise skip. Installed by scripts/treehouse-setup.sh, or by hand:
#     git config core.hooksPath .githooks
top=$(git rev-parse --show-toplevel) || exit 1
python3 "$top/scripts/real_data_check.py" staged || exit 1
own="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-commit"
if [ -x "$own" ]; then
  exec "$own" "$@"
fi
