{
  "name": "conventioner-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only -- {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "brand-icons": "node scripts/brand-icons.ts",
    "bundle-budget": "node scripts/bundle-budget.ts",
    "no-eval": "node scripts/no-eval.ts",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --config .prettierrc.json --write . ../docs",
    "format:check": "prettier --config .prettierrc.json --check . ../docs",
    "test:unit": "vitest run",
    "test:e2e": "npx playwright test",
    "lint:css": "stylelint --max-warnings 0 \"src/**/*.{css,vue}\""
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "konva": "^10.9.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-konva": "^4.0.1",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.4.2",
    "jsqr": "^1.4.0",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
